# .env.example
# This file serves as a template for the .env file, which should
# contain actual sensitive configuration and MUST NOT be committed to Git.
#
# To use: Copy this file to .env and fill in the placeholder values.


# --- Database Configuration ---
# Recommended: A strong, random password.
POSTGRES_DB=tsi_privacy_vault
POSTGRES_USER=tsi_admin
POSTGRES_PASSWD=secure_dev_password

# --- Application Configuration---
# Environment
TSI_PRIVACY_VAULT_ENV=local
# Machine Name
TSI_PRIVACY_VAULT_NODE_ID=MUMBAI_DC_RACK04_SRV01
# 32 byte Master Key 
TSI_PRIVACY_VAULT_MASTER_KEY=6S6vH7pW2zN9kX4jR8mB3vC5xZ1aQ7yP0oL9iK2uJ4M
# One-time setup token. Required by the first-run setup page (init.html) to create
# the SYSTEM_ADMIN account. If unset, setup is refused. Use a long random value.
TSI_PRIVACY_VAULT_BOOTSTRAP_TOKEN=
# JWT Secret 
TSI_PRIVACY_VAULT_JWT_SECRET=v7N2xQ9mR4kL1jP8bW5tZ3yX6sC0vA2d
# Max upload size (in KB)
TSI_PRIVACY_VAULT_MAX_UPLOAD_KB=5120
# Search Index Secret Key
TSI_PRIVACY_VAULT_INDEX_SECRET=k9#z!L2@P$5m*N8^qV1&bX7*jR3+fW0_
# Data Export Path
 TSI_EXPORT_PATH=/var/lib/tsi/exports/

# --- Key Management (docs/design/architecture.md) ---
# Intended root key anchor: LOCAL | AWS_KMS
# Note: the wrapping anchor is switched via the activate_key_anchor admin API;
# this variable declares operator intent and gates AWS configuration.
TSI_PRIVACY_VAULT_KMS_PROVIDER=LOCAL
# AWS KMS anchor (required when activating AWS_KMS)
#TSI_PRIVACY_VAULT_AWS_REGION=ap-south-1
#TSI_PRIVACY_VAULT_AWS_KMS_KEY_ID=arn:aws:kms:ap-south-1:111122223333:key/your-key-id
# Optional endpoint override for testing (e.g., LocalStack http://localstack:4566)
#TSI_PRIVACY_VAULT_AWS_ENDPOINT=
# AWS credentials resolve via the default chain (IAM role preferred).
# Only set these when no instance role/profile is available:
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- File Storage (docs/design/architecture.md, Storage backends) ---
# Where new FILE records are stored: DATABASE (default) | AWS_S3 | S3_COMPATIBLE
# Only ciphertext is ever written to the object store. Existing records stay where they are.
# Apply db/02_file_storage.sql to existing databases before enabling an object store.
TSI_PRIVACY_VAULT_FILE_STORE=DATABASE
#TSI_PRIVACY_VAULT_S3_BUCKET=my-vault-files
#TSI_PRIVACY_VAULT_S3_REGION=ap-south-1
# S3_COMPATIBLE only (MinIO, Ceph RGW). HTTPS required.
#TSI_PRIVACY_VAULT_S3_ENDPOINT=https://minio.internal:9000
# Optional key prefix so one bucket can serve several vaults
#TSI_PRIVACY_VAULT_S3_PREFIX=vault-prod/
# Credentials resolve via the AWS default chain (IAM role preferred).

# --- Erasure by principal (docs/design/architecture.md, per-principal keys and crypto-erasure) ---
# Minutes between scheduled erasure passes (shreds PARTIAL principals whose retention has expired).
# 0 disables the job. Apply db/03_erasure.sql to existing databases first.
#TSI_PRIVACY_VAULT_ERASURE_JOB_MINUTES=60
