{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "shred_record",
  "type": "object",
  "properties": {
    "_func": { "type": "string", "const": "shred_record" },
    "reference_key": { "type": "string", "format": "uuid" },
    "confirm": { "type": "string", "description": "Must equal the principal_id (or reference_key). Shredding is irreversible." }
  },
  "required": ["_func", "reference_key", "confirm"],
  "additionalProperties": false
}
