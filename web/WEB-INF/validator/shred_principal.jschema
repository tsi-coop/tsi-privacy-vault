{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "shred_principal",
  "type": "object",
  "properties": {
    "_func": { "type": "string", "const": "shred_principal" },
    "principal_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,100}$", "description": "Opaque principal identifier. Must not be personal data." },
    "confirm": { "type": "string", "description": "Must equal the principal_id (or reference_key). Shredding is irreversible." }
  },
  "required": ["_func", "principal_id", "confirm"],
  "additionalProperties": false
}
