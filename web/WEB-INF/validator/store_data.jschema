{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "entityType": {
      "type": "string",
      "enum": [
        "ID",
        "DATA",
        "FILE",
        "id",
        "data",
        "file"
      ]
    },
    "entityName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "content": {
      "type": "string"
    },
    "principal_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._:-]{1,100}$"
    },
    "fileName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    }
  },
  "required": [
    "_func",
    "entityType",
    "entityName",
    "content"
  ]
}
