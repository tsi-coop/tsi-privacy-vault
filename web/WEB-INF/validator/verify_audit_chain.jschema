{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verify Audit Chain Request",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string",
      "const": "verify_audit_chain"
    },
    "from_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Start the walk at this chain_seq instead of the first row."
    },
    "expected_head_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "A head recorded earlier outside the database. Supply together with expected_head_hash."
    },
    "expected_head_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  },
  "required": ["_func"],
  "additionalProperties": false
}
