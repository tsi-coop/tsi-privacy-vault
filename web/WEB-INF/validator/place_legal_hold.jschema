{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "place_legal_hold",
  "type": "object",
  "properties": {
    "_func": { "type": "string", "const": "place_legal_hold" },
    "principal_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,100}$", "description": "Opaque principal identifier. Must not be personal data." },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500, "description": "Must not contain personal data." },
    "case_ref": { "type": ["string", "null"], "maxLength": 100 }
  },
  "required": ["_func", "principal_id", "reason"],
  "additionalProperties": false
}
