{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "_func": {
      "type": "string"
    },
    "entity_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "entity_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "flavor": {
      "type": "string",
      "enum": [
        "ID",
        "DATA",
        "FILE",
        "id",
        "data",
        "file"
      ]
    },
    "validation_regex": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "mime_types": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "max_size_kb": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "_func",
    "entity_code",
    "entity_name",
    "flavor",
    "active"
  ]
}
